{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "noEmitOnError": true,
    "types": ["node"],
    "paths": {
      "@server/*": ["./src/*"],
       "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*.ts", "../src/generated/prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
