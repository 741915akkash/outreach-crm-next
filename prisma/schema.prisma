// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Multi - Tenancy Workspace

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

  @@map("workspace_role")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  leads       Lead[]
  pipelines   Pipeline[]
  sources     Source[]
  activities  LeadActivity[]
  sequences   Sequence[]
  companies   Company[]
  deals       Deal[]
  tasks       Task[]
  invitations Invitation[]
  dealLeads   DealLead[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTasks   Task[]       @relation("TaskAssigneeMembership")
  createdTasks    Task[]       @relation("TaskCreatorMembership")
  sentInvitations Invitation[] @relation("InvitationInviterMembership")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation("InvitationInviterMembership", fields: [workspaceId, invitedById], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([workspaceId, invitedById])
  @@map("invitations")
}

// CRM tables

model Lead {
  id          Int      @id @default(autoincrement())
  workspaceId String
  name        String
  companyId   Int?
  email       String?
  phone       String?
  pipelineId  Int?
  stageId     Int?
  sourceId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?      @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Restrict)
  stage      PipelineStage? @relation(fields: [pipelineId, stageId], references: [pipelineId, id], onDelete: Restrict)
  source     Source?        @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict)
  company    Company?       @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Restrict)
  activities LeadActivity[]
  deals      DealLead[]
  tasks      Task[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, id])
  @@index([workspaceId, pipelineId])
  @@index([pipelineId, stageId])
  @@index([workspaceId, sourceId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, phone])
  @@map("leads")
}

model Pipeline {
  id          Int      @id @default(autoincrement())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  leads     Lead[]
  deals     Deal[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("pipelines")
}

model PipelineStage {
  id         Int      @id @default(autoincrement())
  pipelineId Int
  name       String
  position   Int
  color      String?
  createdAt  DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]
  deals    Deal[]

  @@unique([pipelineId, id])
  @@unique([pipelineId, name])
  @@unique([pipelineId, position])
  @@map("pipeline_stages")
}

model Source {
  id          Int      @id @default(autoincrement())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("sources")
}

enum ActivityActorType {
  USER
  TOOL
  AGENT

  @@map("activity_actor_type")
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  LINKEDIN
  SEQUENCE_ASSIGNED
  SEQUENCE_UNASSIGNED
  SEQUENCE_STEP_COMPLETED

  @@map("activity_type")
}

model LeadActivity {
  id             Int               @id @default(autoincrement())
  workspaceId    String
  leadId         Int
  createdByType  ActivityActorType
  createdById    String
  type           ActivityType
  content        String
  sequenceId     Int?
  sequenceStepId Int?
  createdAt      DateTime          @default(now())

  lead         Lead          @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence     Sequence?     @relation(fields: [workspaceId, sequenceId], references: [workspaceId, id], onDelete: Restrict)
  sequenceStep SequenceStep? @relation(fields: [sequenceId, sequenceStepId], references: [sequenceId, id], onDelete: Restrict)

  @@index([workspaceId, leadId, createdAt])
  @@index([workspaceId, sequenceId])
  @@index([sequenceId, sequenceStepId])
  @@index([createdByType, createdById])
  @@map("lead_activities")
}

enum SequenceStepType {
  EMAIL
  CALL
  LINKEDIN
  TASK
  MEETING

  @@map("sequence_step_type")
}

model Sequence {
  id          Int      @id @default(autoincrement())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps      SequenceStep[]
  activities LeadActivity[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("sequences")
}

model SequenceStep {
  id          Int              @id @default(autoincrement())
  sequenceId  Int
  name        String
  description String?
  type        SequenceStepType
  position    Int
  delayDays   Int              @default(0)
  createdAt   DateTime         @default(now())

  sequence   Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  activities LeadActivity[]

  @@unique([sequenceId, name])
  @@unique([sequenceId, id])
  @@unique([sequenceId, position])
  @@map("sequence_steps")
}

model Company {
  id          Int      @id @default(autoincrement())
  workspaceId String
  name        String
  website     String?
  industry    String?
  address     String?
  city        String?
  state       String?
  country     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]
  deals     Deal[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@map("companies")
}

model Deal {
  id                Int       @id @default(autoincrement())
  workspaceId       String
  name              String
  companyId         Int?
  pipelineId        Int
  stageId           Int
  value             Decimal?  @db.Decimal(12, 2)
  currency          String?
  expectedCloseDate DateTime?
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?      @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Restrict)
  pipeline  Pipeline      @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Restrict)
  stage     PipelineStage @relation(fields: [pipelineId, stageId], references: [pipelineId, id], onDelete: Restrict)
  leads     DealLead[]
  tasks     Task[]

  @@unique([workspaceId, id])
  @@index([workspaceId, companyId])
  @@index([workspaceId, pipelineId])
  @@index([pipelineId, stageId])
  @@map("deals")
}

model DealLead {
  workspaceId String
  dealId      Int
  leadId      Int
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal      Deal      @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  lead      Lead      @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)

  @@id([dealId, leadId])
  @@index([workspaceId, dealId])
  @@index([workspaceId, leadId])
  @@map("deal_leads")
}

enum TaskStatus {
  TODO
  DONE

  @@map("task_status")
}

enum TaskPriority {
  P1
  P2
  P3

  @@map("task_priority")
}

model Task {
  id          Int          @id @default(autoincrement())
  workspaceId String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(P2)
  dueDate     DateTime?
  completedAt DateTime?

  assignedToId String
  createdById  String

  leadId Int?
  dealId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo Membership @relation("TaskAssigneeMembership", fields: [workspaceId, assignedToId], references: [workspaceId, userId], onDelete: Restrict)
  createdBy  Membership @relation("TaskCreatorMembership", fields: [workspaceId, createdById], references: [workspaceId, userId], onDelete: Restrict)

  lead Lead? @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict)
  deal Deal? @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, assignedToId, status])
  @@index([workspaceId, createdById])
  @@index([workspaceId, leadId])
  @@index([workspaceId, dealId])
  @@map("tasks")
}
